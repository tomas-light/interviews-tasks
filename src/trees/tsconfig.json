{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "module": "CommonJS",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "noErrorTruncation": true,
    "strict": true,
    "sourceMap": true,
    "target": "ESNext",
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": ["RedBlackTreeVisualizer.tsx",
    "RedBlackTreeNode.ts"
  ]
}
